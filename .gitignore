# Сырьё скачанных документов — в git не хранится, в git хранится только манифест.
data/raw/*
!data/raw/manifest.jsonl
# Silver set — производные данные, но маленькие и нужны P4 импортом.
data/silver/*
!data/silver/.gitkeep
!data/silver/*.jsonl
!data/silver/summary.json

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# WSL / Windows
*:Zone.Identifier
.DS_Store
data/pgdata/

# Производные данные: чанки, векторы, кэш индекса. Все они — функция от сырья и
# кода, и пересобираются командами из README. В репозиторий не идут по двум
# причинам: 96 МБ против 2.8, и потому что пара «корпус + векторы» расходится
# незаметно. Этот проект трижды получал правдоподобные неверные числа именно на
# устаревших артефактах; класть такую пару в историю значит закреплять риск.
#
# В репозитории остаётся то, что из него не восстановить: разметка silver set,
# манифест сырья с хешами и результаты замеров.
data/chunks/

# Внутренние документы замысла продукта P5: контекстный бриф, спека цепочки
# проектов, спека чанкинга и рыночное исследование. В публичный репозиторий
# не выкладываются. Техническое задание самого P3 остаётся.
00-context-brief.md
01-p3-p4-p5-spec.md
02-nk-rf-chunking-spec.md
compass_artifact_*.md
